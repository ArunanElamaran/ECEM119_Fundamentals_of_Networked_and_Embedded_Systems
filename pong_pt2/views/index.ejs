<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>IMU Pong</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div class="container">
      <h1>Two-Player IMU-Controlled Pong</h1>
      <p class="hint">
        Player 1: Arduino IMU paddle (palm up/down to move). Player 2: keyboard — ↑/↓ to move paddle, ← for random background color.
      </p>

      <canvas id="pongCanvas" width="800" height="400"></canvas>

      <div class="status">
        <div class="paddle-status" id="p1Status">P1: searching…</div>
        <div class="paddle-status" id="p2Status">P2: searching…</div>
      </div>
    </div>

    <script src="/pong.js"></script>
  </body>
</html>

